# Vector store: Chroma PersistentClient (lưu trên đĩa, không cần Docker).
CHROMA_PATH=chroma_db

# Embedding qua OpenRouter (API tương thích OpenAI). Copy file này thành .env và điền key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
